# =============================================================================
# QXAudit — main host + document RAG helpers
# =============================================================================

APP_NAME=QXAudit
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
# Docker host publish port (container still uses APP_PORT=8080 inside)
HOST_PORT=9090
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_FORMAT=json
TZ=UTC
PYTHONUNBUFFERED=1

# LLM
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1

# QXAudit host + docs_ask → RAG helper
HERMES_SYSTEM_PROMPT_PATH=prompts/hermes_coordinator.md
HERMES_ENABLED_TOOLSETS=docs_bridge,graph_bridge
HERMES_MAX_ITERATIONS=12
HERMES_SESSION_HISTORY_LIMIT=6
# false = keep multi-turn history in host agent
HERMES_SKIP_MEMORY=false
HERMES_QUIET_MODE=true
HERMES_SKIP_CONTEXT_FILES=true
# OpenAI gpt-4* / gpt-4.1: must be false (Hermes default reasoning.effort breaks)
HERMES_REASONING_ENABLED=false
# Cheap model for Open WebUI housekeeping prompts (title/tags/follow-up);
# they bypass tools and session memory entirely
HERMES_TASK_MODEL=gpt-4.1-mini
# HERMES_REASONING_EFFORT=medium
HERMES_HOME=/home/appuser/.hermes

# DocViewer helper (JSON document + tools; stubs until implemented)
DOCVIEWER_ENABLED=true
# DOCVIEWER_ECHO_DOCUMENT=false

# Self-improving (global Q/A recipe store)
SELF_IMPROVE_ENABLED=true
SELF_IMPROVE_STORE_PATH=./data/self_improve.json
SELF_IMPROVE_TOP_K=3
SELF_IMPROVE_MIN_SCORE=0.18
SELF_IMPROVE_MAX_RECIPES=500

# Document RAG helper
RAG_ENABLED=true
RAG_DOCS_DIR=./data/docs
RAG_CHROMA_ROOT=./data/rag/chroma
RAG_SYSTEM_PROMPT_PATH=prompts/rag_agent_system.md
# remote = embedding-service HTTP; openai/local = in-process
RAG_EMBED_PROVIDER=remote
RAG_EMBED_URL=http://127.0.0.1:8090
# RAG_EMBED_BEARER_TOKEN=
RAG_EMBED_MODEL=text-embedding-3-small
# RAG_EMBED_DIM=
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
RAG_EMBED_BATCH_SIZE=32
RAG_AUTO_REINDEX_ON_MISMATCH=false

# Comma-separated origins. "*" lets any browser origin call the API — only for
# local development. Example: CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ORIGINS=*
API_WORKERS=1
API_RELOAD=false
# REQUIRED in any shared/production deployment: without it /v1/chat,
# /v1/graph/ask and /v1/docs/* are open to anyone who can reach the port.
# The gateway (Open WebUI) must send the same value as "Authorization: Bearer <token>".
# API_BEARER_TOKEN=

# Inside container healthcheck still uses 8080; from host use HOST_PORT (9090)
HEALTHCHECK_URL=http://127.0.0.1:8080/health
HEALTHCHECK_TIMEOUT_SECONDS=5

# =============================================================================
# Neo4j (graph store — container; agent/tool wiring later)
# Browser: http://127.0.0.1:7474   Bolt: bolt://127.0.0.1:7687
# From QXAudit app container: bolt://neo4j:7687
# =============================================================================
NEO4J_ENABLED=true
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_USER=neo4j
# Change this before production / first login
NEO4J_PASSWORD=qxaudit-neo4j-change-me
NEO4J_URI=bolt://neo4j:7687
NEO4J_DATABASE=neo4j
NEO4J_HEAP_INITIAL=512m
NEO4J_HEAP_MAX=1G
NEO4J_PAGECACHE=512m
# NEO4J_PLUGINS=["apoc"]
